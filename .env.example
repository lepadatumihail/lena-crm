# Supabase — from your project's API settings (https://supabase.com/dashboard)
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# New publishable key (sb_publishable_…). For legacy projects you can instead
# set NEXT_PUBLIC_SUPABASE_ANON_KEY — the app reads whichever is present.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role / secret key (server-only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the app, used for OAuth redirect callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Support inbox (Resend) ---
# Sends the in-app help & feedback dialog to info@leadwing.app. Without a key
# the dialog tells the agent to write to that address instead.
# RESEND_API_KEY=
# Envelope sender. Optional — defaults to the line below. Resend only accepts a
# `from` on a domain verified in the account; leadwing.app is verified, so this
# only needs setting to send from somewhere else.
# SUPPORT_FROM_EMAIL="LeadWing <info@leadwing.app>"

# --- Deferred (email automation) — not required for v1 ---
# Reuses RESEND_API_KEY above.

# --- Billing (Stripe) ---
# Payment Links from the Stripe dashboard, one per price. Each price needs a
# lookup key equal to its plan id (founding_monthly, founding_yearly,
# standard_monthly, standard_yearly): the webhook reads it to know the plan.
# The pricing page appends client_reference_id (= the agent's auth user id)
# so the webhook can link the Stripe customer to the profile.
# NEXT_PUBLIC_STRIPE_LINK_FOUNDING_MONTHLY=
# NEXT_PUBLIC_STRIPE_LINK_FOUNDING_YEARLY=
# NEXT_PUBLIC_STRIPE_LINK_STANDARD_MONTHLY=
# NEXT_PUBLIC_STRIPE_LINK_STANDARD_YEARLY=
# Server-only. Without these the webhook answers 503, the Customer Portal is
# unavailable and balance credits stay "pending" in the ledger; the admin
# page still works by hand. Point the webhook at https://www.leadwing.app
# (the apex redirects, and Stripe does not follow redirects).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

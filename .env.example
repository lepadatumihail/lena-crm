# Supabase — from your project's API settings (https://supabase.com/dashboard)
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# New publishable key (sb_publishable_…). For legacy projects you can instead
# set NEXT_PUBLIC_SUPABASE_ANON_KEY — the app reads whichever is present.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role / secret key (server-only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the app, used for OAuth redirect callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Deferred (email automation) — not required for v1 ---
# RESEND_API_KEY=

# --- Billing (Stripe) ---
# Payment Links from the Stripe dashboard, one per price. The upgrade page
# appends client_reference_id (= the agent's auth user id) so the webhook can
# link the Stripe customer to the profile.
# NEXT_PUBLIC_STRIPE_LINK_FOUNDING_MONTHLY=
# NEXT_PUBLIC_STRIPE_LINK_FOUNDING_ANNUAL=
# NEXT_PUBLIC_STRIPE_LINK_STANDARD_MONTHLY=
# NEXT_PUBLIC_STRIPE_LINK_STANDARD_ANNUAL=
# Server-only. Without these the webhook answers 503 and referral credits stay
# "pending" in the ledger; the admin page still works by hand.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

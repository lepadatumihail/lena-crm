{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "leadwing-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "leadwing-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "DEBUG_WEBKIT=1 npx next start -p 3100"
      ],
      "port": 3100
    }
  ]
}
